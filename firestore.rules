rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && (
        !(request.auth.token.get('email', '').lower() == 'teste@gmail.com'
          || request.auth.token.get('email', '').lower().matches('.*[.]test$'))
        || request.auth.token.get('aud', '') == 'demo-caravana77-test');
    }
    function adminOrg() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.organizationId
        : '';
    }
    function hasMembership(orgId) {
      return signedIn() && exists(/databases/$(database)/documents/memberships/$(request.auth.uid)/organizations/$(orgId));
    }
    function membership(orgId) {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid)/organizations/$(orgId)).data;
    }
    function activeMembership(orgId) {
      return hasMembership(orgId)
        && membership(orgId).uid == request.auth.uid
        && membership(orgId).organizationId == orgId
        && membership(orgId).status == 'active'
        && membership(orgId).role in ['tenant_owner', 'staff'];
    }
    function legacyAccess(orgId) {
      let organization = /databases/$(database)/documents/organizations/$(orgId);
      return signedIn() && adminOrg() == orgId && !hasMembership(orgId)
        && (!exists(organization) || (
          (!('legacyAdminAccessEnabled' in get(organization).data) || get(organization).data.legacyAdminAccessEnabled == true)
          && (!('legacyAdminAccessUntil' in get(organization).data) || request.time < get(organization).data.legacyAdminAccessUntil)));
    }
    // Legacy compatibility is explicit and can be cut off per organization only after migration.
    // An existing revoked/invalid membership NEVER falls back to admins/{uid}.
    function isAdmin(orgId) { return signedIn() && (activeMembership(orgId) || legacyAccess(orgId)); }
    function isTenantOwner(orgId) {
      return signedIn() && ((activeMembership(orgId) && membership(orgId).role == 'tenant_owner') || legacyAccess(orgId));
    }
    function isPlatformOwner() {
      return signedIn() && exists(/databases/$(database)/documents/platformOwners/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformOwners/$(request.auth.uid)).data.status == 'active';
    }
    function publicCaravan(caravanId) {
      return exists(/databases/$(database)/documents/caravans/$(caravanId))
        && get(/databases/$(database)/documents/caravans/$(caravanId)).data.status == 'published'
        && acceptsReservations(get(/databases/$(database)/documents/caravans/$(caravanId)).data.organizationId);
    }
    function acceptsReservations(orgId) {
      return !exists(/databases/$(database)/documents/organizations/$(orgId))
        || get(/databases/$(database)/documents/organizations/$(orgId)).data.get('status', 'active') != 'suspended';
    }
    function platformOperation(orgId, operationId, action) {
      let path = /databases/$(database)/documents/platformAudit/$(operationId);
      let event = getAfter(path).data;
      return isPlatformOwner() && operationId.matches('^[a-f0-9]{32}$') && !exists(path)
        && event.organizationId == orgId && event.actorUid == request.auth.uid
        && event.action == action && event.at == request.time;
    }
    function supportGrant(orgId, operatorUid) {
      return get(/databases/$(database)/documents/supportGrants/$(orgId)/operators/$(operatorUid)).data;
    }
    function supportEvent(orgId, eventId, operatorUid, action) {
      let path = /databases/$(database)/documents/supportGrants/$(orgId)/audit/$(eventId);
      let event = getAfter(path).data;
      return eventId.matches('^[a-f0-9]{32}$') && !exists(path)
        && event.organizationId == orgId && event.operatorUid == operatorUid
        && event.actorUid == request.auth.uid && event.action == action && event.at == request.time;
    }
    function usableSupportGrant(orgId, operatorUid) {
      let grant = supportGrant(orgId, operatorUid);
      return grant.organizationId == orgId && grant.operatorUid == operatorUid
        && grant.status == 'active' && grant.scope == 'caravan_configuration_read'
        && grant.expiresAt > request.time;
    }
    function canSupportConfiguration(orgId) {
      let session = get(/databases/$(database)/documents/supportSessions/$(request.auth.uid)).data;
      return isPlatformOwner() && session.operatorUid == request.auth.uid
        && session.organizationId == orgId && session.status == 'active'
        && session.scope == 'caravan_configuration_read' && session.expiresAt > request.time
        && usableSupportGrant(orgId, request.auth.uid)
        && session.consentId == supportGrant(orgId, request.auth.uid).consentId
        && session.expiresAt <= supportGrant(orgId, request.auth.uid).expiresAt;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /profiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /organizations/{orgId} {
      allow get: if isAdmin(orgId) || isPlatformOwner();
      allow list: if isPlatformOwner();
      allow create: if request.resource.data.keys().hasOnly(['name', 'slug', 'ownerUid', 'status', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'lastPlatformOperationId'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
        && request.resource.data.slug == orgId && orgId.matches('^[a-z0-9][a-z0-9-]{2,59}$')
        && request.resource.data.ownerUid is string && request.resource.data.ownerUid.matches('^[^/]{1,128}$')
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid
        && platformOperation(orgId, request.resource.data.lastPlatformOperationId, 'tenant_created');
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy', 'lastPlatformOperationId'])
        && resource.data.get('status', 'active') in ['active', 'suspended']
        && request.resource.data.status in ['active', 'suspended']
        && request.resource.data.status != resource.data.get('status', 'active')
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid
        && platformOperation(orgId, request.resource.data.lastPlatformOperationId, 'tenant_status_changed');
      allow delete: if false;
    }
    match /organizationAvailability/{orgId} {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if isPlatformOwner()
        && request.resource.data.keys().hasOnly(['organizationId', 'status', 'updatedAt', 'lastPlatformOperationId'])
        && request.resource.data.organizationId == orgId && request.resource.data.updatedAt == request.time
        && request.resource.data.status == getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.status
        && request.resource.data.lastPlatformOperationId == getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.lastPlatformOperationId
        && (platformOperation(orgId, request.resource.data.lastPlatformOperationId, 'tenant_created')
          || platformOperation(orgId, request.resource.data.lastPlatformOperationId, 'tenant_status_changed'));
    }

    match /memberships/{uid}/organizations/{orgId} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow create: if isPlatformOwner()
        && request.resource.data.keys().hasOnly(['uid', 'organizationId', 'role', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.organizationId == orgId
        && request.resource.data.role == 'tenant_owner' && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/organizations/$(orgId))
        && getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.ownerUid == uid
        && platformOperation(orgId, getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.lastPlatformOperationId, 'tenant_created');
      allow update, delete: if false;
    }
    match /platformOwners/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /platformAudit/{operationId} {
      allow get, list: if isPlatformOwner() || (resource != null && isTenantOwner(resource.data.organizationId));
      allow update, delete: if false;
      allow create: if isPlatformOwner()
        && request.resource.data.keys().hasOnly(['action', 'organizationId', 'actorUid', 'at', 'previousStatus', 'status', 'details'])
        && request.resource.data.actorUid == request.auth.uid && request.resource.data.at == request.time
        && request.resource.data.details is map
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.lastPlatformOperationId == operationId
        && getAfter(/databases/$(database)/documents/organizationAvailability/$(request.resource.data.organizationId)).data.lastPlatformOperationId == operationId
        && getAfter(/databases/$(database)/documents/organizationAvailability/$(request.resource.data.organizationId)).data.status == request.resource.data.status
        && ((request.resource.data.action == 'tenant_created' && request.resource.data.previousStatus == 'absent' && request.resource.data.status == 'active'
          && !exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId))
          && request.resource.data.details.keys().hasOnly(['name', 'slug', 'ownerUid'])
          && request.resource.data.details.name == getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.name
          && request.resource.data.details.slug == getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.slug
          && request.resource.data.details.ownerUid == getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerUid
          && getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.details.ownerUid)/organizations/$(request.resource.data.organizationId)).data.uid == request.resource.data.details.ownerUid
          && getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.details.ownerUid)/organizations/$(request.resource.data.organizationId)).data.organizationId == request.resource.data.organizationId
          && getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.details.ownerUid)/organizations/$(request.resource.data.organizationId)).data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.details.ownerUid)/organizations/$(request.resource.data.organizationId)).data.role == 'tenant_owner'
          && getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.details.ownerUid)/organizations/$(request.resource.data.organizationId)).data.status == 'active')
        || (request.resource.data.action == 'tenant_status_changed' && request.resource.data.details.keys().hasOnly([])
          && request.resource.data.previousStatus == get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.get('status', 'active')
          && request.resource.data.status == getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.status
          && request.resource.data.previousStatus != request.resource.data.status));
    }

    match /supportGrants/{orgId}/operators/{operatorUid} {
      function validConsent(data) {
        return data.keys().hasOnly(['organizationId', 'operatorUid', 'status', 'scope', 'purpose', 'approvedBy', 'grantedAt', 'expiresAt', 'consentId', 'lastEventId'])
          && data.organizationId == orgId && data.operatorUid == operatorUid
          && data.status == 'active' && data.scope == 'caravan_configuration_read'
          && data.purpose is string && data.purpose.size() >= 3 && data.purpose.size() <= 200
          && data.approvedBy == request.auth.uid && data.grantedAt == request.time
          && data.expiresAt is timestamp && data.expiresAt > request.time
          && data.expiresAt <= request.time + duration.value(1, 'h')
          && data.consentId == data.lastEventId
          && exists(/databases/$(database)/documents/platformOwners/$(operatorUid))
          && get(/databases/$(database)/documents/platformOwners/$(operatorUid)).data.status == 'active'
          && supportEvent(orgId, data.lastEventId, operatorUid, 'support_granted');
      }
      allow get: if isTenantOwner(orgId) || (isPlatformOwner() && request.auth.uid == operatorUid);
      allow list: if isTenantOwner(orgId);
      allow create: if isTenantOwner(orgId) && validConsent(request.resource.data);
      allow update: if isTenantOwner(orgId) && (validConsent(request.resource.data)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastEventId'])
          && resource.data.status == 'active' && request.resource.data.status == 'revoked'
          && supportEvent(orgId, request.resource.data.lastEventId, operatorUid, 'support_revoked')));
      allow delete: if false;
    }
    match /supportSessions/{operatorUid} {
      function validSession(data) {
        return data.keys().hasOnly(['organizationId', 'operatorUid', 'status', 'scope', 'purpose', 'openedAt', 'expiresAt', 'consentId', 'lastEventId'])
          && data.operatorUid == operatorUid && data.status == 'active'
          && data.scope == 'caravan_configuration_read' && data.openedAt == request.time
          && usableSupportGrant(data.organizationId, operatorUid)
          && data.consentId == supportGrant(data.organizationId, operatorUid).consentId
          && data.purpose == supportGrant(data.organizationId, operatorUid).purpose
          && data.expiresAt is timestamp && data.expiresAt > request.time
          && data.expiresAt <= supportGrant(data.organizationId, operatorUid).expiresAt
          && supportEvent(data.organizationId, data.lastEventId, operatorUid, 'support_opened');
      }
      allow get: if isPlatformOwner() && request.auth.uid == operatorUid;
      allow list, delete: if false;
      allow create: if isPlatformOwner() && request.auth.uid == operatorUid && validSession(request.resource.data);
      allow update: if isPlatformOwner() && request.auth.uid == operatorUid && (validSession(request.resource.data)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastEventId'])
          && resource.data.status == 'active' && request.resource.data.status == 'closed'
          && supportEvent(resource.data.organizationId, request.resource.data.lastEventId, operatorUid, 'support_closed')));
    }
    match /supportGrants/{orgId}/audit/{eventId} {
      function matchingGrant(action) {
        let path = /databases/$(database)/documents/supportGrants/$(orgId)/operators/$(request.resource.data.operatorUid);
        let grant = getAfter(path).data;
        return isTenantOwner(orgId) && grant.lastEventId == eventId
          && (!exists(path) || get(path).data.lastEventId != eventId)
          && grant.consentId == request.resource.data.consentId && grant.scope == request.resource.data.scope
          && grant.purpose == request.resource.data.purpose && grant.expiresAt == request.resource.data.expiresAt
          && ((action == 'support_granted' && grant.status == 'active' && grant.consentId == eventId)
            || (action == 'support_revoked' && grant.status == 'revoked'));
      }
      function matchingSession(action) {
        let path = /databases/$(database)/documents/supportSessions/$(request.auth.uid);
        let session = getAfter(path).data;
        return isPlatformOwner() && request.resource.data.operatorUid == request.auth.uid
          && session.organizationId == orgId && session.lastEventId == eventId
          && (!exists(path) || get(path).data.lastEventId != eventId)
          && session.consentId == request.resource.data.consentId && session.scope == request.resource.data.scope
          && session.purpose == request.resource.data.purpose && session.expiresAt == request.resource.data.expiresAt
          && ((action == 'support_opened' && session.status == 'active') || (action == 'support_closed' && session.status == 'closed'));
      }
      allow get: if isTenantOwner(orgId) || (isPlatformOwner() && (resource == null || resource.data.operatorUid == request.auth.uid));
      allow list: if isTenantOwner(orgId) || (isPlatformOwner() && resource.data.operatorUid == request.auth.uid);
      allow update, delete: if false;
      allow create: if eventId.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['organizationId', 'operatorUid', 'actorUid', 'action', 'at', 'consentId', 'scope', 'expiresAt', 'purpose'])
        && request.resource.data.organizationId == orgId && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time && request.resource.data.scope == 'caravan_configuration_read'
        && (matchingGrant(request.resource.data.action) || matchingSession(request.resource.data.action));
    }

    match /caravans/{caravanId} {
      allow get, list: if (resource.data.status == 'published') || isAdmin(resource.data.organizationId)
        || (signedIn() && canSupportConfiguration(resource.data.organizationId));
      allow create: if isTenantOwner(request.resource.data.organizationId)
        && request.resource.data.reservedSeats == 0
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0
        && request.resource.data.capacity <= 1000;
      allow update: if (isTenantOwner(resource.data.organizationId)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.capacity is int
          && request.resource.data.capacity > 0
          && request.resource.data.capacity <= 1000
          && request.resource.data.reservedSeats is int
          && request.resource.data.reservedSeats >= 0
          && request.resource.data.reservedSeats <= request.resource.data.capacity)
        || (resource.data.status == 'published'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reservedSeats', 'lastReservationNonce', 'lastReservationId', 'updatedAt'])
          && !('lastReservationId' in request.resource.data)
          && request.resource.data.reservedSeats == resource.data.reservedSeats + 1
          && request.resource.data.reservedSeats <= resource.data.capacity
          && request.resource.data.lastReservationNonce is string
          && request.resource.data.lastReservationNonce.matches('^[a-f0-9]{64}$')
          && existsAfter(/databases/$(database)/documents/reservationReceipts/$(request.resource.data.lastReservationNonce))
          && getAfter(/databases/$(database)/documents/reservationReceipts/$(request.resource.data.lastReservationNonce)).data.caravanId == caravanId
          && getAfter(/databases/$(database)/documents/reservationReceipts/$(request.resource.data.lastReservationNonce)).data.organizationId == resource.data.organizationId
          && existsAfter(/databases/$(database)/documents/registrations/$(getAfter(/databases/$(database)/documents/reservationReceipts/$(request.resource.data.lastReservationNonce)).data.registrationId))
          && getAfter(/databases/$(database)/documents/registrations/$(getAfter(/databases/$(database)/documents/reservationReceipts/$(request.resource.data.lastReservationNonce)).data.registrationId)).data.reservationNonce == request.resource.data.lastReservationNonce
          && getAfter(/databases/$(database)/documents/registrations/$(getAfter(/databases/$(database)/documents/reservationReceipts/$(request.resource.data.lastReservationNonce)).data.registrationId)).data.caravanId == caravanId
          && getAfter(/databases/$(database)/documents/registrations/$(getAfter(/databases/$(database)/documents/reservationReceipts/$(request.resource.data.lastReservationNonce)).data.registrationId)).data.registrationStatus == 'awaiting_payment');
      allow delete: if isTenantOwner(resource.data.organizationId);
    }

    // This unguessable, unreadable receipt links a public nonce to the private registration ID.
    match /reservationReceipts/{nonce} {
      allow get, list: if false;
      allow create: if request.resource.data.keys().hasOnly(['registrationId', 'organizationId', 'caravanId'])
        && request.resource.data.registrationId is string
        && request.resource.data.registrationId.matches('^[a-f0-9]{64}$')
        && nonce.matches('^[a-f0-9]{64}$')
        && nonce != request.resource.data.registrationId
        && request.resource.data.organizationId is string
        && request.resource.data.caravanId is string
        && publicCaravan(request.resource.data.caravanId)
        && get(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.organizationId == request.resource.data.organizationId
        && getAfter(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.lastReservationNonce == nonce
        && getAfter(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.reservedSeats == get(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.reservedSeats + 1
        && getAfter(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.reservedSeats <= get(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.capacity
        && existsAfter(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId))
        && getAfter(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.id == request.resource.data.registrationId
        && getAfter(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.reservationNonce == nonce
        && getAfter(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.organizationId == request.resource.data.organizationId
        && getAfter(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.caravanId == request.resource.data.caravanId;
      allow update: if false;
      allow delete: if isAdmin(resource.data.organizationId)
        || (exists(/databases/$(database)/documents/caravans/$(resource.data.caravanId))
          && get(/databases/$(database)/documents/caravans/$(resource.data.caravanId)).data.organizationId == resource.data.organizationId
          && getAfter(/databases/$(database)/documents/caravans/$(resource.data.caravanId)).data.lastReservationNonce != nonce);
    }

    match /registrations/{registrationId} {
      function validLegacyImport(id) {
        let data = request.resource.data;
        let trip = get(/databases/$(database)/documents/caravans/$(data.caravanId));
        let tripAfter = getAfter(/databases/$(database)/documents/caravans/$(data.caravanId));
        return data.keys().hasAll(['id', 'importedFromLegacy', 'importBatchId', 'organizationId', 'caravanId', 'caravanName', 'passengerName', 'phone', 'email', 'city', 'boardingPointId', 'boardingPointName', 'emergencyContact', 'notes', 'registrationStatus', 'paymentStatus', 'createdAt'])
          && data.keys().hasOnly(['id', 'importedFromLegacy', 'importBatchId', 'organizationId', 'caravanId', 'caravanName', 'passengerName', 'cpf', 'documentRecords', 'birthDate', 'isMinor', 'guardianName', 'guardianPhone', 'authorizationStatus', 'phone', 'email', 'city', 'boardingPointId', 'boardingPointName', 'emergencyContact', 'notes', 'amountCents', 'paymentTotalCents', 'paymentReportedMethod', 'paymentReportedUnreconciled', 'registrationStatus', 'paymentStatus', 'createdAt'])
          && id.matches('^[a-f0-9]{64}$')
          && data.id == id
          && data.importedFromLegacy == true
          && data.importBatchId is string
          && data.importBatchId.matches('^[a-f0-9]{32}$')
          && data.organizationId is string
          && isAdmin(data.organizationId)
          && data.caravanId is string
          && exists(/databases/$(database)/documents/caravans/$(data.caravanId))
          && existsAfter(/databases/$(database)/documents/caravans/$(data.caravanId))
          && trip.data.organizationId == data.organizationId
          && tripAfter.data.reservedSeats is int
          && tripAfter.data.reservedSeats > trip.data.reservedSeats
          && tripAfter.data.capacity is int
          && tripAfter.data.reservedSeats <= tripAfter.data.capacity
          && data.caravanName is string
          && data.passengerName is string
          && data.passengerName.size() >= 2
          && data.passengerName.size() <= 120
          && data.phone is string
          && data.phone.size() <= 30
          && (data.phone.size() == 0 || data.phone.size() >= 8)
          && data.email is string
          && data.email.size() <= 254
          && ((data.phone.size() > 0 || data.email.size() > 0)
            || ('cpf' in data)
            || ('documentRecords' in data && data.documentRecords is list && data.documentRecords.size() > 0))
          && data.city is string
          && data.city.size() <= 120
          && data.boardingPointId is string
          && data.boardingPointName is string
          && data.boardingPointName.size() <= 120
          && data.emergencyContact is string
          && data.emergencyContact.size() <= 120
          && data.notes is string
          && data.notes.size() <= 1000
          && (!('amountCents' in data) || (data.amountCents is int && data.amountCents > 0))
          && (!('paymentTotalCents' in data) || (data.paymentTotalCents is int && data.paymentTotalCents >= 0))
          && data.paymentStatus in ['pending', 'approved', 'reported']
          && ((data.paymentStatus == 'pending' && data.registrationStatus == 'awaiting_payment')
            || (data.paymentStatus == 'approved' && data.registrationStatus == 'confirmed')
            || (data.paymentStatus == 'reported' && data.registrationStatus == 'confirmed'
              && data.paymentReportedMethod == 'pix' && data.paymentReportedUnreconciled == true))
          && (data.paymentStatus == 'reported'
            || (!('paymentReportedMethod' in data) && !('paymentReportedUnreconciled' in data)))
          && data.createdAt is string
          && (!('cpf' in data) || (data.cpf is string && data.cpf.matches('^[0-9]{11}$')))
          && (!('birthDate' in data) || (data.birthDate is string && data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (!('isMinor' in data) || data.isMinor is bool)
          && (!('guardianName' in data) || (data.guardianName is string && data.guardianName.size() >= 2 && data.guardianName.size() <= 120))
          && (!('guardianPhone' in data) || (data.guardianPhone is string && data.guardianPhone.size() >= 8 && data.guardianPhone.size() <= 30))
          && (!('authorizationStatus' in data) || data.authorizationStatus in ['unknown', 'not_required', 'not_sent', 'pending', 'received', 'approved'])
          && (!('isMinor' in data && data.isMinor) || ('birthDate' in data && 'guardianName' in data && 'guardianPhone' in data && data.authorizationStatus in ['not_sent', 'pending', 'received', 'approved']))
          && (!('isMinor' in data && !data.isMinor && 'authorizationStatus' in data) || data.authorizationStatus == 'not_required')
          && (!('documentRecords' in data) || (data.documentRecords is list && data.documentRecords.size() <= 3))
          && (!('requiresMinorAuthorization' in trip.data) || trip.data.requiresMinorAuthorization != true || data.paymentStatus == 'reported' || ('birthDate' in data && 'isMinor' in data && 'authorizationStatus' in data));
      }
      // Import candidates and opaque reservation retries may test absence (no document data).
      // Existing records still require organization authority or an active bearer link.
      allow get: if (resource == null
          && (signedIn() || registrationId.matches('^[a-f0-9]{64}$')))
        || (resource != null
          && (isAdmin(resource.data.organizationId) || (registrationId.matches('^[a-f0-9]{64}$')
            && (!('portalAccessRevoked' in resource.data) || resource.data.portalAccessRevoked == false))));
      allow list: if isAdmin(resource.data.organizationId);
      allow create: if validLegacyImport(registrationId) || (request.resource.data.id == registrationId
        && registrationId.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['id', 'reservationNonce', 'reservationRequestHash', 'organizationId', 'caravanId', 'caravanName', 'passengerName', 'cpf', 'birthDate', 'isMinor', 'guardianName', 'guardianPhone', 'authorizationStatus', 'phone', 'email', 'city', 'boardingPointId', 'boardingPointName', 'emergencyContact', 'notes', 'amountCents', 'registrationStatus', 'paymentStatus', 'createdAt'])
        && (!('reservationRequestHash' in request.resource.data) || (request.resource.data.reservationRequestHash is string && request.resource.data.reservationRequestHash.matches('^[a-f0-9]{64}$')))
        && request.resource.data.reservationNonce is string
        && request.resource.data.reservationNonce.matches('^[a-f0-9]{64}$')
        && request.resource.data.reservationNonce != registrationId
        && request.resource.data.registrationStatus == 'awaiting_payment'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.passengerName is string
        && request.resource.data.passengerName.size() >= 2
        && request.resource.data.passengerName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 30
        && (!('cpf' in request.resource.data) || (request.resource.data.cpf is string && request.resource.data.cpf.matches('^[0-9]{11}$')))
        && (!('birthDate' in request.resource.data) || (request.resource.data.birthDate is string && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('isMinor' in request.resource.data) || request.resource.data.isMinor is bool)
        && (!('guardianName' in request.resource.data) || (request.resource.data.guardianName is string && request.resource.data.guardianName.size() >= 2 && request.resource.data.guardianName.size() <= 120))
        && (!('guardianPhone' in request.resource.data) || (request.resource.data.guardianPhone is string && request.resource.data.guardianPhone.size() >= 8 && request.resource.data.guardianPhone.size() <= 30))
        && (!('authorizationStatus' in request.resource.data) || request.resource.data.authorizationStatus in ['not_required', 'not_sent'])
        && (!('isMinor' in request.resource.data && request.resource.data.isMinor) || ('birthDate' in request.resource.data && 'guardianName' in request.resource.data && 'guardianPhone' in request.resource.data && request.resource.data.authorizationStatus == 'not_sent'))
        && (!('isMinor' in request.resource.data && !request.resource.data.isMinor && 'authorizationStatus' in request.resource.data) || request.resource.data.authorizationStatus == 'not_required')
        && request.resource.data.organizationId is string
        && request.resource.data.caravanId is string
        && publicCaravan(request.resource.data.caravanId)
        && get(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.organizationId == request.resource.data.organizationId
        && get(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.priceCents == request.resource.data.amountCents
        && getAfter(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.lastReservationNonce == request.resource.data.reservationNonce
        && getAfter(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.reservedSeats == get(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.reservedSeats + 1
        && getAfter(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.reservedSeats <= get(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.capacity
        && existsAfter(/databases/$(database)/documents/reservationReceipts/$(request.resource.data.reservationNonce))
        && getAfter(/databases/$(database)/documents/reservationReceipts/$(request.resource.data.reservationNonce)).data.registrationId == registrationId
        && getAfter(/databases/$(database)/documents/reservationReceipts/$(request.resource.data.reservationNonce)).data.caravanId == request.resource.data.caravanId
        && getAfter(/databases/$(database)/documents/reservationReceipts/$(request.resource.data.reservationNonce)).data.organizationId == request.resource.data.organizationId
          && (!('requiresMinorAuthorization' in get(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data)
          || get(/databases/$(database)/documents/caravans/$(request.resource.data.caravanId)).data.requiresMinorAuthorization != true
          || ('birthDate' in request.resource.data && 'isMinor' in request.resource.data && 'authorizationStatus' in request.resource.data))
        && request.resource.data.boardingPointId is string
        && request.resource.data.boardingPointName is string
        && request.resource.data.createdAt is string);
      allow update: if (isAdmin(resource.data.organizationId)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.caravanId == resource.data.caravanId
          && request.resource.data.get('id', registrationId) == resource.data.get('id', registrationId)
          && request.resource.data.get('reservationNonce', '') == resource.data.get('reservationNonce', '')
          && request.resource.data.get('reservationRequestHash', '') == resource.data.get('reservationRequestHash', '')
          && (isTenantOwner(resource.data.organizationId)
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['amountCents', 'paymentTotalCents', 'paymentReportedMethod', 'paymentReportedUnreconciled'])))
        || ((!('portalAccessRevoked' in resource.data) || resource.data.portalAccessRevoked == false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proofId', 'paymentStatus', 'registrationStatus', 'proofUploadedAt'])
          && resource.data.registrationStatus in ['awaiting_payment', 'awaiting_review', 'rejected']
          && request.resource.data.paymentStatus == 'awaiting_review'
          && request.resource.data.registrationStatus == 'awaiting_review'
          && request.resource.data.proofId == 'current'
          && request.resource.data.proofUploadedAt is timestamp
          && request.resource.data.proofUploadedAt <= request.time
          && existsAfter(/databases/$(database)/documents/registrations/$(registrationId)/proofs/current)
          && getAfter(/databases/$(database)/documents/registrations/$(registrationId)/proofs/current).data.registrationId == registrationId);
      // Preserve operation identity and history; cancellation is the controlled reversal.
      allow delete: if false;

      match /payments/{paymentId} {
        function parentRegistration() {
          return get(/databases/$(database)/documents/registrations/$(registrationId)).data;
        }
        function validPaymentFields(data) {
          return data.amountCents is int
            && data.amountCents > 0
            && data.method in ['pix', 'transfer', 'cash', 'card', 'other']
            && data.notes is string
            && data.notes.size() <= 500
            && (!('paymentDate' in data) || (data.paymentDate is string && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
        }
        allow get, list: if isAdmin(parentRegistration().organizationId);
        allow create: if request.resource.data.keys().hasAll(['id', 'registrationId', 'organizationId', 'caravanId', 'amountCents', 'method', 'notes', 'status', 'createdAt', 'createdBy'])
          && request.resource.data.keys().hasOnly(['id', 'registrationId', 'organizationId', 'caravanId', 'amountCents', 'method', 'paymentDate', 'notes', 'status', 'createdAt', 'createdBy'])
          && paymentId.matches('^[a-zA-Z0-9_-]{1,128}$')
          && request.resource.data.id == paymentId
          && request.resource.data.registrationId == registrationId
          && request.resource.data.organizationId == parentRegistration().organizationId
          && request.resource.data.caravanId == parentRegistration().caravanId
          && isTenantOwner(request.resource.data.organizationId)
          && parentRegistration().registrationStatus != 'cancelled'
          && validPaymentFields(request.resource.data)
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt is string
          && request.resource.data.createdBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/registrations/$(registrationId)).data.paymentTotalCents
            == (('paymentTotalCents' in parentRegistration()) ? parentRegistration().paymentTotalCents : 0) + request.resource.data.amountCents
          && getAfter(/databases/$(database)/documents/registrations/$(registrationId)).data.paymentTotalCents is int
          && getAfter(/databases/$(database)/documents/registrations/$(registrationId)).data.paymentTotalCents >= 0
          && (!('amountCents' in parentRegistration())
            || getAfter(/databases/$(database)/documents/registrations/$(registrationId)).data.paymentTotalCents <= parentRegistration().amountCents);
        allow update: if resource.data.registrationId == registrationId
          && isTenantOwner(resource.data.organizationId)
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidReason', 'voidedAt', 'voidedBy'])
          && request.resource.data.status == 'voided'
          && request.resource.data.voidReason is string
          && request.resource.data.voidReason.size() >= 3
          && request.resource.data.voidReason.size() <= 300
          && request.resource.data.voidedAt is timestamp
          && request.resource.data.voidedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/registrations/$(registrationId)).data.paymentTotalCents
            == parentRegistration().paymentTotalCents - resource.data.amountCents
          && getAfter(/databases/$(database)/documents/registrations/$(registrationId)).data.paymentTotalCents is int
          && getAfter(/databases/$(database)/documents/registrations/$(registrationId)).data.paymentTotalCents >= 0;
        allow delete: if false;
      }

      match /proofs/{proofId} {
        function registration() {
          return get(/databases/$(database)/documents/registrations/$(registrationId)).data;
        }
        function validProof() {
          let registrationData = registration();
          let updatedRegistration = getAfter(/databases/$(database)/documents/registrations/$(registrationId)).data;
          return proofId == 'current'
            && (!('portalAccessRevoked' in registrationData) || registrationData.portalAccessRevoked == false)
            && request.resource.data.keys().hasOnly(['registrationId', 'organizationId', 'caravanId', 'contentType', 'fileName', 'content', 'uploadedAt'])
            && request.resource.data.registrationId == registrationId
            && request.resource.data.organizationId == registrationData.organizationId
            && request.resource.data.caravanId == registrationData.caravanId
            && request.resource.data.contentType in ['image/jpeg', 'image/png', 'application/pdf']
            && request.resource.data.fileName is string
            && request.resource.data.fileName.size() > 0
            && request.resource.data.fileName.size() <= 120
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 819200
            && ((request.resource.data.contentType == 'application/pdf' && request.resource.data.content.matches('^JVBERi0.*$'))
              || (request.resource.data.contentType == 'image/png' && request.resource.data.content.matches('^iVBORw0KGgo.*$'))
              || (request.resource.data.contentType == 'image/jpeg' && request.resource.data.content.matches('^/9j/.*$')))
            && request.resource.data.uploadedAt is timestamp
            && request.resource.data.uploadedAt <= request.time
            && registrationData.registrationStatus in ['awaiting_payment', 'awaiting_review', 'rejected']
            && updatedRegistration.proofId == proofId
            && updatedRegistration.registrationStatus == 'awaiting_review';
        }
        allow get, list: if resource.data.registrationId == registrationId
          && isAdmin(resource.data.organizationId);
        allow create, update: if validProof();
        allow delete: if resource.data.registrationId == registrationId
          && isAdmin(resource.data.organizationId);
      }
    }

    match /caravans/{caravanId}/expenses/{expenseId} {
      function validExpense(data) {
        return data.description is string
          && data.description.size() >= 3
          && data.description.size() <= 120
          && data.category in ['transporte', 'alimentacao', 'pedagio', 'estacionamento', 'outros']
          && data.amountCents is int
          && data.amountCents > 0
          && data.date is string
          && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.notes is string
          && data.notes.size() <= 500;
      }
      allow get, list: if isAdmin(
        get(/databases/$(database)/documents/caravans/$(caravanId)).data.organizationId,
      );
      allow create: if request.resource.data.keys().hasAll(['id', 'organizationId', 'caravanId', 'description', 'category', 'amountCents', 'date', 'notes', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasOnly(['id', 'organizationId', 'caravanId', 'description', 'category', 'amountCents', 'date', 'notes', 'createdAt', 'createdBy'])
        && request.resource.data.id == expenseId
        && request.resource.data.caravanId == caravanId
        && request.resource.data.organizationId == get(/databases/$(database)/documents/caravans/$(caravanId)).data.organizationId
        && isTenantOwner(request.resource.data.organizationId)
        && validExpense(request.resource.data)
        && request.resource.data.createdAt is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if resource.data.caravanId == caravanId
        && isTenantOwner(resource.data.organizationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'category', 'amountCents', 'date', 'notes', 'updatedAt', 'updatedBy'])
        && validExpense(request.resource.data)
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
