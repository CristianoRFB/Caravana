rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && (
        !(request.auth.token.get('email', '').lower() == 'teste@gmail.com'
          || request.auth.token.get('email', '').lower().matches('.*[.]test$'))
        || request.auth.token.get('aud', '') == 'demo-caravana77-test');
    }
    function adminOrg() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.organizationId
        : '';
    }
    function hasMembership(orgId) {
      return exists(/databases/$(database)/documents/memberships/$(request.auth.uid)/organizations/$(orgId));
    }
    function membership(orgId) {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid)/organizations/$(orgId)).data;
    }
    function activeMembership(orgId) {
      let member = membership(orgId);
      return hasMembership(orgId)
        && member.uid == request.auth.uid
        && member.organizationId == orgId
        && member.status == 'active'
        && member.role in ['tenant_owner', 'staff'];
    }
    function legacyAccess(orgId) {
      let organization = /databases/$(database)/documents/organizations/$(orgId);
      let settings = get(organization).data;
      return adminOrg() == orgId && !hasMembership(orgId)
        && (!exists(organization) || (
          settings.get('legacyAdminAccessEnabled', true) == true
          && request.time < settings.get('legacyAdminAccessUntil', request.time + duration.value(1, 's'))));
    }
    // Legacy compatibility is explicit and can be cut off per organization only after migration.
    // An existing revoked/invalid membership NEVER falls back to admins/{uid}.
    function isAdmin(orgId) { return signedIn() && (hasMembership(orgId) ? activeMembership(orgId) : legacyAccess(orgId)); }
    function isTenantOwner(orgId) {
      return signedIn() && (hasMembership(orgId) ? (activeMembership(orgId) && membership(orgId).role == 'tenant_owner') : legacyAccess(orgId));
    }
    function isPlatformOwner() {
      return signedIn() && exists(/databases/$(database)/documents/platformOwners/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformOwners/$(request.auth.uid)).data.status == 'active';
    }
    function publicCaravan(caravanId) {
      return exists(/databases/$(database)/documents/caravans/$(caravanId))
        && get(/databases/$(database)/documents/caravans/$(caravanId)).data.status == 'published'
        && get(/databases/$(database)/documents/caravans/$(caravanId)).data.get('importPending', false) == false
        && acceptsReservations(get(/databases/$(database)/documents/caravans/$(caravanId)).data.organizationId);
    }
    // A copied historical tenant remains read-only until a separately reviewed cutover.
    function tenantWritesEnabled(orgId) {
      return !exists(/databases/$(database)/documents/organizations/$(orgId))
        || get(/databases/$(database)/documents/organizations/$(orgId)).data.get('importPending', false) == false;
    }
    function acceptsReservations(orgId) {
      return !exists(/databases/$(database)/documents/organizations/$(orgId))
        || get(/databases/$(database)/documents/organizations/$(orgId)).data.get('status', 'active') != 'suspended';
    }
    function platformOperation(orgId, operationId, action) {
      let path = /databases/$(database)/documents/platformAudit/$(operationId);
      let event = getAfter(path).data;
      return isPlatformOwner() && operationId.matches('^[a-f0-9]{32}$') && !exists(path)
        && event.organizationId == orgId && event.actorUid == request.auth.uid
        && event.action == action && event.at == request.time;
    }
    function namespaceBootstrapReady() {
      let marker = get(/databases/$(database)/documents/namespaceBootstrap/state).data;
      return marker.version == 'namespace-v1' && marker.coverageVersion == 'tenant-references-v2'
        && marker.inventoryComplete == true && marker.manifestHash.matches('^[a-f0-9]{64}$');
    }
    function newTenantNamespace(orgId, op) {
      return namespaceBootstrapReady() && !exists(/databases/$(database)/documents/organizations/$(orgId))
        && !exists(/databases/$(database)/documents/tenantNamespaces/$(orgId))
        && platformOperation(orgId, op, 'tenant_created');
    }
    match /namespaceBootstrap/{id} {
      allow get: if isPlatformOwner();
      allow list, create, update, delete: if false;
    }
    match /tenantNamespaces/{id} {
      allow get: if isPlatformOwner();
      allow list, update, delete: if false;
      allow create: if newTenantNamespace(id, request.resource.data.lastPlatformOperationId)
        && request.resource.data.keys().hasOnly(['namespace', 'organizationId', 'state', 'version', 'createdAt', 'actorUid', 'lastPlatformOperationId'])
        && request.resource.data.namespace == id && request.resource.data.organizationId == id
        && request.resource.data.state == 'active' && request.resource.data.version == 'namespace-v1'
        && request.resource.data.createdAt == request.time && request.resource.data.actorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(id)).data.lastPlatformOperationId == request.resource.data.lastPlatformOperationId;
    }
    function supportGrant(orgId, operatorUid) {
      return get(/databases/$(database)/documents/supportGrants/$(orgId)/operators/$(operatorUid)).data;
    }
    function supportEvent(orgId, eventId, operatorUid, action) {
      let path = /databases/$(database)/documents/supportGrants/$(orgId)/audit/$(eventId);
      let event = getAfter(path).data;
      return eventId.matches('^[a-f0-9]{32}$') && !exists(path)
        && event.organizationId == orgId && event.operatorUid == operatorUid
        && event.actorUid == request.auth.uid && event.action == action && event.at == request.time;
    }
    function usableSupportGrant(orgId, operatorUid) {
      let grant = supportGrant(orgId, operatorUid);
      return grant.organizationId == orgId && grant.operatorUid == operatorUid
        && grant.status == 'active' && grant.scope == 'caravan_configuration_read'
        && grant.expiresAt > request.time;
    }
    function canSupportConfiguration(orgId) {
      let session = get(/databases/$(database)/documents/supportSessions/$(request.auth.uid)).data;
      return isPlatformOwner() && session.operatorUid == request.auth.uid
        && session.organizationId == orgId && session.status == 'active'
        && session.scope == 'caravan_configuration_read' && session.expiresAt > request.time
        && usableSupportGrant(orgId, request.auth.uid)
        && session.consentId == supportGrant(orgId, request.auth.uid).consentId
        && session.expiresAt <= supportGrant(orgId, request.auth.uid).expiresAt;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /profiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Operator-created activation ledger is immutable to every client.
    match /organizations/{orgId}/tenantActivations/{operationId} {
      allow get: if isTenantOwner(orgId);
      allow list, create, update, delete: if false;
    }

    function publicTenantSlug(slug) {
      return slug is string && slug.matches('^[a-z0-9][a-z0-9-]{2,59}$') && !(slug in ['admin', 'platform', 'api', 'www', 'conta', 'demo']);
    }
    function brandWebsite(url) {
      return url is string && (url == '' || (url.matches('^https://[a-zA-Z0-9-]+([.][a-zA-Z0-9-]+)+(/[^\\s#]*)?$')
        && !url.matches('^https://[0-9.]+(/.*)?$') && !url.matches('^https://.*[.](local|internal|test)(/.*)?$')));
    }
    function brandImage(logo) {
      return logo is string && (logo == ''
        || (logo.size() <= 87384 && logo.matches('^(data:image/png;base64,iVBORw0KGgo|data:image/jpeg;base64,/9j/)[a-zA-Z0-9+/]*={0,2}$'))
        || (logo.size() <= 1000 && brandWebsite(logo) && logo.matches('.*[.]([pP][nN][gG]|[jJ][pP][eE]?[gG]|[wW][eE][bB][pP])([?][^#]*)?$')));
    }
    match /tenantSlugs/{slug} {
      allow get: if true;
      allow list, update, delete: if false;
      allow create: if publicTenantSlug(slug) && request.resource.data.keys().hasOnly(['slug', 'organizationId'])
        && (!exists(/databases/$(database)/documents/organizations/$(slug)) || slug == request.resource.data.organizationId)
        && (!exists(/databases/$(database)/documents/tenantNamespaces/$(slug)) || get(/databases/$(database)/documents/tenantNamespaces/$(slug)).data.organizationId == request.resource.data.organizationId)
        && request.resource.data.slug == slug
        && (isTenantOwner(request.resource.data.organizationId) || newTenantNamespace(request.resource.data.organizationId, getAfter(/databases/$(database)/documents/publicTenantSettings/$(request.resource.data.organizationId)).data.lastBrandOperationId))
        && getAfter(/databases/$(database)/documents/publicTenantSettings/$(request.resource.data.organizationId)).data.slug == slug;
    }
    match /publicTenantSettings/{orgId} {
      function valid(data) {
        return data.keys().hasOnly(['organizationId', 'slug', 'publicName', 'description', 'primaryColor', 'logo', 'website', 'contactEmail', 'whatsapp', 'operationalMessage', 'updatedAt', 'lastBrandOperationId'])
          && data.organizationId == orgId && publicTenantSlug(data.slug)
          && data.publicName is string && data.publicName.size() >= 2 && data.publicName.size() <= 80
          && data.description is string && data.description.size() <= 240
          && data.primaryColor in ['#6d4aff', '#1d4ed8', '#0f766e', '#166534', '#9f1239', '#7e22ce', '#92400e', '#334155']
          && brandImage(data.logo) && data.website.size() <= 500 && brandWebsite(data.website)
          && data.contactEmail is string && data.contactEmail.size() <= 120
          && (data.contactEmail == '' || data.contactEmail.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$'))
          && data.whatsapp is string && (data.whatsapp == '' || data.whatsapp.matches('^[0-9]{8,15}$'))
          && data.operationalMessage is string && data.operationalMessage.size() <= 800
          && data.updatedAt == request.time && data.lastBrandOperationId.matches('^[a-f0-9]{32}$')
          && ((exists(/databases/$(database)/documents/organizations/$(orgId))
              && !exists(/databases/$(database)/documents/tenantBrandOperations/$(data.lastBrandOperationId))
              && getAfter(/databases/$(database)/documents/tenantBrandOperations/$(data.lastBrandOperationId)).data.settings == data)
            || (!exists(/databases/$(database)/documents/organizations/$(orgId)) && newTenantNamespace(orgId, data.lastBrandOperationId)
              && getAfter(/databases/$(database)/documents/platformAudit/$(data.lastBrandOperationId)).data.details.branding == data))
          && getAfter(/databases/$(database)/documents/tenantSlugs/$(data.slug)).data.organizationId == orgId;
      }
      allow get: if true;
      allow list, delete: if false;
      allow create: if (isTenantOwner(orgId) || newTenantNamespace(orgId, request.resource.data.lastBrandOperationId)) && valid(request.resource.data);
      allow update: if isTenantOwner(orgId) && request.resource.data.slug == resource.data.slug && valid(request.resource.data);
    }
    match /tenantBrandOperations/{operationId} {
      allow get: if (resource == null && signedIn()) || (resource != null && isAdmin(resource.data.organizationId));
      allow list: if isAdmin(resource.data.organizationId);
      allow create: if isTenantOwner(request.resource.data.organizationId)
        && request.resource.data.keys().hasOnly(['organizationId', 'actorUid', 'at', 'action', 'slug', 'settings'])
        && request.resource.data.actorUid == request.auth.uid && request.resource.data.at == request.time && request.resource.data.action == 'branding_saved'
        && request.resource.data.settings.lastBrandOperationId == operationId && request.resource.data.slug == request.resource.data.settings.slug
        && getAfter(/databases/$(database)/documents/publicTenantSettings/$(request.resource.data.organizationId)).data == request.resource.data.settings;
      allow update, delete: if false;
    }
    // Historical aliases are provisioned only by an explicitly approved administrative migration.
    match /legacyTripAliases/{slug} { allow get: if true; allow list, create, update, delete: if false; }
    function commercialPlan(planId) {
      return planId == 'essencial' ? { 'monthlyCents': 8900, 'limits': { 'activeCaravans': 2, 'passengersPerCaravan': 60, 'internalUsers': 2 } }
        : planId == 'pro' ? { 'monthlyCents': 14900, 'limits': { 'activeCaravans': 5, 'passengersPerCaravan': 200, 'internalUsers': 5 } }
        : { 'monthlyCents': 21900, 'limits': { 'activeCaravans': 15, 'passengersPerCaravan': 500, 'internalUsers': 15 } };
    }
    function quotaGrowth(orgId) {
      let policy = get(/databases/$(database)/documents/tenantEntitlements/$(orgId)).data;
      return tenantWritesEnabled(orgId) && acceptsReservations(orgId) && policy.growthEnabled == true && (policy.growthUntil == null || request.time < policy.growthUntil);
    }
    function functionalFeatures(planId) {
      return planId == 'premium' ? ['caravans', 'registrations', 'proofs', 'checkin', 'csv_import', 'finance', 'branding', 'report_library', 'worklists']
        : planId == 'pro' ? ['caravans', 'registrations', 'proofs', 'checkin', 'csv_import', 'finance', 'branding', 'report_library']
        : ['caravans', 'registrations', 'proofs', 'checkin', 'csv_import', 'finance', 'branding'];
    }
    // New commercial tools never gate the existing core, security or historical reads.
    function functionalGrowth(orgId, feature) {
      let subscription = get(/databases/$(database)/documents/subscriptions/$(orgId)).data;
      let projection = get(/databases/$(database)/documents/organizations/$(orgId)/commercialFeatures/current).data;
      let organization = get(/databases/$(database)/documents/organizations/$(orgId)).data;
      return isAdmin(orgId) && organization.get('importPending', false) == false && organization.get('status', 'active') != 'suspended'
        && subscription.status in ['active', 'trial', 'demo']
        && (subscription.trialEndsAt == null || request.time < subscription.trialEndsAt)
        && feature in functionalFeatures(subscription.planId)
        && projection.lastCommercialOperationId == subscription.lastCommercialOperationId
        && projection.planId == subscription.planId && projection.status == subscription.status;
    }
    match /organizations/{orgId}/commercialFeatures/{id} {
      allow get: if isAdmin(orgId) || isPlatformOwner();
      allow list, delete: if false;
      allow create, update: if id == 'current' && isPlatformOwner()
        && existsAfter(/databases/$(database)/documents/organizations/$(orgId))
        && request.resource.data == {
          'organizationId': orgId, 'version': 'features-v1',
          'planId': getAfter(/databases/$(database)/documents/subscriptions/$(orgId)).data.planId,
          'features': functionalFeatures(getAfter(/databases/$(database)/documents/subscriptions/$(orgId)).data.planId),
          'status': getAfter(/databases/$(database)/documents/subscriptions/$(orgId)).data.status,
          'validUntil': getAfter(/databases/$(database)/documents/subscriptions/$(orgId)).data.trialEndsAt,
          'updatedAt': request.time,
          'lastCommercialOperationId': getAfter(/databases/$(database)/documents/subscriptions/$(orgId)).data.lastCommercialOperationId
        } && getAfter(/databases/$(database)/documents/subscriptions/$(orgId)).data.updatedAt == request.time;
    }
    function toolEnvelope(orgId, kind, entityId, data) {
      let event = getAfter(/databases/$(database)/documents/organizations/$(orgId)/toolEvents/$(data.lastToolOperationId)).data;
      return data.organizationId == orgId && data.updatedAt == request.time && data.updatedBy == request.auth.uid
        && data.lastToolOperationId.matches('^[a-f0-9]{32}$')
        && !exists(/databases/$(database)/documents/organizations/$(orgId)/toolEvents/$(data.lastToolOperationId))
        && event.organizationId == orgId && event.actorUid == request.auth.uid && event.at == request.time
        && event.kind == kind && event.entityId == entityId;
    }
    function validReportFinance(value) {
      let unknown = value.get('unknownPaymentCount', 0);
      return value is map && value.keys().hasOnly(['passengerCount', 'paidPassengerCount', 'partialPassengerCount', 'pendingPassengerCount', 'reportedPassengerCount', 'unknownPaymentCount', 'unknownFareCount', 'expectedCents', 'receivedCents', 'receivableCents', 'uncertainReceivableCount', 'expenseCents', 'recordedBalanceCents', 'projectedResultCents'])
 && value.passengerCount is int && value.passengerCount >= 0 && value.passengerCount <= 9000000000000
 && value.paidPassengerCount is int && value.paidPassengerCount >= 0 && value.paidPassengerCount <= 9000000000000
 && value.partialPassengerCount is int && value.partialPassengerCount >= 0 && value.partialPassengerCount <= 9000000000000
 && value.pendingPassengerCount is int && value.pendingPassengerCount >= 0 && value.pendingPassengerCount <= 9000000000000
 && value.reportedPassengerCount is int && value.reportedPassengerCount >= 0 && value.reportedPassengerCount <= 9000000000000
 && value.unknownFareCount is int && value.unknownFareCount >= 0 && value.unknownFareCount <= 9000000000000
 && value.expectedCents is int && value.expectedCents >= 0 && value.expectedCents <= 9000000000000
 && value.uncertainReceivableCount is int && value.uncertainReceivableCount >= 0 && value.uncertainReceivableCount <= 9000000000000
 && value.expenseCents is int && value.expenseCents >= 0 && value.expenseCents <= 9000000000000
 && value.projectedResultCents is int && value.projectedResultCents >= -9000000000000 && value.projectedResultCents <= 9000000000000
        && unknown is int && unknown >= 0 && unknown <= 9000000000000
        && ((unknown == 0
          && value.receivedCents is int && value.receivedCents >= 0 && value.receivedCents <= 9000000000000
          && value.receivableCents is int && value.receivableCents >= 0 && value.receivableCents <= 9000000000000
          && value.recordedBalanceCents is int && value.recordedBalanceCents >= -9000000000000 && value.recordedBalanceCents <= 9000000000000
          && value.recordedBalanceCents == value.receivedCents - value.expenseCents)
          || (unknown > 0 && value.receivedCents == null && value.receivableCents == null && value.recordedBalanceCents == null))
        && value.projectedResultCents == value.expectedCents - value.expenseCents;
    }
    match /organizations/{orgId}/reports/{reportId} {
      function validReport(data) {
        let summary = data.summary;
        return data.keys().hasOnly(['organizationId', 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'lastToolOperationId', 'title', 'from', 'to', 'caravanId', 'summary'])
          && data.title is string && data.title.size() >= 3 && data.title.size() <= 100
          && data.from is string && data.from.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
          && data.to is string && data.to.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
          && (data.from == '' || validCalendarDate(data.from)) && (data.to == '' || validCalendarDate(data.to))
          && (data.from == '' || data.to == '' || data.from <= data.to)
          && data.caravanId is string && data.caravanId.size() <= 128 && !data.caravanId.matches('.*[/].*')
          && summary.keys().hasOnly(['trips', 'capacity', 'boarded', 'pendingAuthorizations', 'finance'])
          && money(summary.trips) && summary.trips <= 50 && money(summary.capacity) && money(summary.boarded) && money(summary.pendingAuthorizations)
          && validReportFinance(summary.finance)
          && data.revision == 1 && data.createdAt == request.time && data.createdBy == request.auth.uid && data.lastToolOperationId == reportId;
      }
      allow get, list: if isAdmin(orgId);
      allow update, delete: if false;
      allow create: if reportId.matches('^[a-f0-9]{32}$') && functionalGrowth(orgId, 'report_library')
        && validReport(request.resource.data)
        && toolEnvelope(orgId, 'report', reportId, request.resource.data);
    }
    function validWorklist(orgId, data) {
      return data.keys().hasOnly(['organizationId', 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'lastToolOperationId', 'title', 'kind', 'caravanId', 'tasksText', 'doneMask', 'archived'])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 100 && data.archived is bool
        && data.tasksText is string && data.tasksText.size() <= 2419
        && data.tasksText.matches('^[^\\r\\n]{1,120}(\\n[^\\r\\n]{1,120}){0,19}$')
        && data.doneMask is string && data.doneMask.matches('^[01]{1,20}$')
        && data.doneMask.size() == data.tasksText.split('\\n').size()
        && data.revision is int && data.revision >= 1 && data.revision <= 1000000
        && ((data.kind == 'template' && data.caravanId == null && isTenantOwner(orgId))
          || (data.kind == 'trip' && data.caravanId is string && data.caravanId.size() >= 1 && data.caravanId.size() <= 128
            && !data.caravanId.matches('.*[/].*') && get(/databases/$(database)/documents/caravans/$(data.caravanId)).data.organizationId == orgId));
    }
    match /organizations/{orgId}/worklists/{worklistId} {
      allow get, list: if isAdmin(orgId);
      allow delete: if false;
      allow create: if worklistId.matches('^[a-f0-9]{32}$') && functionalGrowth(orgId, 'worklists')
        && validWorklist(orgId, request.resource.data) && toolEnvelope(orgId, 'worklist', worklistId, request.resource.data)
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if functionalGrowth(orgId, 'worklists') && validWorklist(orgId, request.resource.data)
        && toolEnvelope(orgId, 'worklist', worklistId, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.kind == resource.data.kind && request.resource.data.caravanId == resource.data.caravanId
        && request.resource.data.revision == resource.data.revision + 1;
    }
    match /organizations/{orgId}/toolEvents/{operationId} {
      function validToolEvent(data) {
        let collectionName = data.kind == 'report' ? 'reports' : 'worklists';
        let target = /databases/$(database)/documents/organizations/$(orgId)/$(collectionName)/$(data.entityId);
        let existed = exists(target);
        let before = existed ? get(target).data : {};
        return data.keys().hasOnly(['organizationId', 'actorUid', 'at', 'kind', 'entityId', 'payloadHash', 'before', 'after'])
          && operationId.matches('^[a-f0-9]{32}$') && data.entityId.matches('^[a-f0-9]{32}$') && data.kind in ['report', 'worklist']
          && data.organizationId == orgId && data.actorUid == request.auth.uid && data.at == request.time && data.payloadHash.matches('^[a-f0-9]{64}$')
          && ((existed && data.before == before) || (!existed && data.before == null))
          && (!existed || getAfter(target).data != before)
          && getAfter(target).data == data.after && data.after.organizationId == orgId && data.after.lastToolOperationId == operationId && data.after.updatedAt == request.time;
      }
      allow get, list: if isAdmin(orgId);
      allow update, delete: if false;
      // Actual target mutation is required. Its rule enforces ACL/feature; this
      // event binds the exact before/after and actor, without evaluating ACL twice.
      allow create: if signedIn() && validToolEvent(request.resource.data);
    }
    function quotaSeats(orgId, seats) {
      return quotaGrowth(orgId) && seats is int && seats >= 0
        && seats <= get(/databases/$(database)/documents/tenantEntitlements/$(orgId)).data.limits.passengersPerCaravan;
    }
    // Invitations are authoritative here; the private inbox is only an exact projection.
    function invitationPath(orgId, uid) {
      return /databases/$(database)/documents/tenantInvitations/$(orgId)/users/$(uid);
    }
    function invitationAcceptance(orgId, uid, op) {
      let path = invitationPath(orgId, uid);
      let before = get(path).data;
      let after = getAfter(path).data;
      return signedIn() && request.auth.uid == uid && exists(path)
        && before.organizationId == orgId && before.uid == uid && before.role in ['tenant_owner', 'staff']
        && before.status == 'pending' && before.expiresAt > request.time
        && after.diff(before).affectedKeys().hasOnly(['status', 'acceptedAt', 'updatedAt', 'lastOperationId'])
        && after.status == 'accepted' && after.acceptedAt == request.time && after.updatedAt == request.time && after.lastOperationId == op;
    }
    function invitationQuota(orgId, uid, op) {
      let path = /databases/$(database)/documents/tenantQuotaOperations/$(op);
      let event = getAfter(path).data;
      return !exists(path) && event.organizationId == orgId && event.entityId == uid
        && event.kind == 'member' && event.action == 'member_accepted' && event.actorUid == uid;
    }
    function pendingInvitee(orgId) {
      let path = invitationPath(orgId, request.auth.uid);
      return signedIn() && exists(path) && get(path).data.status == 'pending'
        && get(path).data.uid == request.auth.uid && get(path).data.organizationId == orgId
        && get(path).data.expiresAt > request.time;
    }
    function invitationEvent(event, orgId, op) {
      let path = invitationPath(orgId, event.uid);
      let existed = exists(path);
      let before = existed ? get(path).data : {};
      let after = getAfter(path).data;
      return !exists(/databases/$(database)/documents/tenantInvitations/$(orgId)/events/$(op))
        && op.matches('^[a-f0-9]{32}$') && event.keys().hasOnly(['organizationId', 'uid', 'actorUid', 'action', 'at', 'requestHash', 'reason', 'before', 'after'])
        && event.organizationId == orgId && event.actorUid == request.auth.uid && event.at == request.time
        && event.requestHash.matches('^[a-f0-9]{64}$') && event.reason is string && event.reason.size() >= 3 && event.reason.size() <= 300
