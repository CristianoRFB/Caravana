rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function adminOrg() {
      return signedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.organizationId
        : '';
    }
    match /proofs/{orgId}/{caravanId}/{registrationId}/{fileName} {
      function registration() {
        return firestore.get(/databases/(default)/documents/registrations/$(registrationId)).data;
      }
      allow read: if signedIn() && adminOrg() == orgId;
      allow create: if registration().organizationId == orgId
        && registration().caravanId == caravanId
        && registration().registrationStatus in ['awaiting_payment', 'awaiting_review', 'rejected']
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('^(image/jpeg|image/png|application/pdf)$');
      allow update, delete: if signedIn() && adminOrg() == orgId;
    }
  }
}
